# Copy this file to .env and fill only the providers you use.

# Optional provider selector. CLI --provider still takes precedence.
ROBIN_PROVIDER=deepseek

# Optional protocol override: chat-completions, responses, anthropic-messages, ollama-chat.
# CLI --api takes precedence; leave blank to use the provider default.
ROBIN_API=

# Optional model budget overrides; blank uses robin.models.json or defaults.
ROBIN_MAX_NEW_TOKENS=
ROBIN_CONTEXT_WINDOW=

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
ROBIN_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
ROBIN_DEEPSEEK_API_KEY=
ROBIN_DEEPSEEK_MODEL=deepseek-v4-flash

# Optional right.codes shared key. Used by --provider openai and --provider anthropic when provider-specific keys are empty.
ROBIN_RIGHT_CODES_API_KEY=

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
ROBIN_OPENAI_API_BASE=https://www.right.codes/codex/v1
ROBIN_OPENAI_API_KEY=
ROBIN_OPENAI_MODEL=gpt-5.4

# Default Anthropic-compatible endpoint. Can reuse ROBIN_RIGHT_CODES_API_KEY when your gateway shares one key.
ROBIN_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
ROBIN_ANTHROPIC_API_KEY=
ROBIN_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
ROBIN_SECRET_ENV_NAMES=
